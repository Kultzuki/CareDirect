# Copy to .env. Never commit .env. Sandbox only.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
APP_SECRET_KEY=replace_with_a_random_local_secret
# Upload tokens are random and stored only as SHA-256 hashes; no token secret is needed.
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=20
MAX_UPLOAD_PAGES=20
UPLOAD_TOKEN_TTL_MINUTES=60

# PayPal REST Sandbox — India Business provider app only
PAYPAL_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Required for payment approval. Configured Sandbox account evidence, not hospital identity.
PAYPAL_EXPECTED_MERCHANT_ID=
PAYPAL_BINDING_CAPTURE_ID=
PAYPAL_PROVIDER_EMAIL=
PAYPAL_BUYER_EMAIL=

# Database (local Docker Compose default; adjust only if your compose config differs)
DATABASE_URL=postgresql+psycopg://caredirect:caredirect_dev_only@127.0.0.1:5432/caredirect

# DeepSeek-V4.1-Flash via Godel Machines (Care Episode Intelligence)
# Put your actual student API key in the private .env copy, never in this example file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.goedelmachines.com/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=3000
# Episode AI runs only when requested; normal page reads make no model requests.
# Student/free requests may be stored by the provider. Use synthetic data for evaluation.

# Google AI Studio / Gemini — image and PDF extraction.
# Paste the real key only in your private .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RPM=5
GEMINI_TPM=250000
GEMINI_RPD=20

# auto selects Gemini when GEMINI_API_KEY is set, otherwise synthetic replay.
# Set mock explicitly for offline demos/tests. Real Gemini output always needs human review.
DOCUMENT_AI_PROVIDER=auto

# Private local file storage for development; production should use private object storage.
STORAGE_BACKEND=local
STORAGE_DIR=./storage
